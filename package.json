{
  "name": "federated-echo-league",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.23.5"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build && tsc -p tools/tsconfig.json",
    "check:boundaries": "node tools/boundaries/cli.ts",
    "test": "pnpm check:boundaries && vitest run",
    "match": "node packages/runner/src/cli.ts",
    "viewer": "pnpm --filter @fel/viewer dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
